# Copie para .env e preencha. O arquivo .env NÃO vai para o git.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
# Gmail: use uma "senha de app" (exige verificação em duas etapas), não a senha normal.
SMTP_PASS=
MAIL_FROM=seu-email@gmail.com
# Destinatários dos contratos que não têm "emails_aviso" próprio
MAIL_TO=destino@empresa.com
# Dias de antecedência dos avisos (padrão 30,15,7,1,0)
GC_ANTECEDENCIA=30,15,7,1,0
